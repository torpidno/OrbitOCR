<UserControl x:Class="OrbitOCR.UI.ActionMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="480" d:DesignHeight="110"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <!-- Compact variants of the app buttons, sized for a floating menu -->
        <Style x:Key="PillPrimary" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="PillGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Floating surface: this is one of the few layers allowed a shadow -->
    <Border Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            Margin="8"
            MaxWidth="520">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header: mode badge + preview -->
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="BadgeBorder"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="5" Padding="7,3" Margin="0,0,9,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadge" Text="Text" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                </Border>

                <TextBlock Grid.Column="1" x:Name="TextPreview"
                           Text="Select text or circle an image"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="330"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>

                <Button Grid.Column="2" x:Name="BtnClose" Style="{StaticResource IconButton}"
                        ToolTip="Close (Esc)" Width="24" Height="24"
                        AutomationProperties.Name="Close">
                    <Path Data="M 2,2 L 10,10 M 10,2 L 2,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>

            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,9"/>

            <!-- Actions: the contextual primary gets the accent, the rest stay neutral -->
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="BtnSearchLens" Style="{StaticResource PillGhost}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 2,5 L 4,2 L 10,2 L 12,5 L 13,5 A 1,1 0 0 1 14,6 L 14,12 A 1,1 0 0 1 13,13 L 1,13 A 1,1 0 0 1 0,12 L 0,6 A 1,1 0 0 1 1,5 Z M 7,5.5 A 2.5,2.5 0 1 0 7,10.5 A 2.5,2.5 0 1 0 7,5.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Search with Lens" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCopyText" Style="{StaticResource PillPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 3,5 A 2,2 0 0 1 5,3 L 11,3 A 2,2 0 0 1 13,5 L 13,11 A 2,2 0 0 1 11,13 L 5,13 A 2,2 0 0 1 3,11 Z M 5,1 L 11,1 A 2,2 0 0 1 13,3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtBtnCopyText" Text="Copy Text" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSearchGoogle" Style="{StaticResource PillGhost}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 6.5,2 A 4.5,4.5 0 1 0 11,6.5 M 10,10 L 14,14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Search Google" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCopyImage" Style="{StaticResource PillGhost}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 2,2 L 12,2 L 12,12 L 2,12 Z M 4,8 L 6,6 L 8,9 L 10,5 L 12,8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Copy Image" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSaveImage" Style="{StaticResource PillGhost}"
                        ToolTip="Save image to file" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 2,2 L 10,2 L 12,4 L 12,12 L 2,12 Z M 4,2 L 4,5 L 10,5 L 10,2 M 4,8 L 10,8 L 10,12 L 4,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save Image" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
