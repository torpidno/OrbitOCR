<Window x:Class="OrbitOCR.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:OrbitOCR.UI"
        mc:Ignorable="d"
        Title="OrbitOCR Snip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        Cursor="Cross">

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Layer 1: Frozen Desktop Screenshot -->
        <Image x:Name="FrozenScreenImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Layer 2: Dimmed Overlay with Cutout Mask -->
        <Path x:Name="DimmedMaskPath" Fill="#70000000"/>

        <!-- Layer 3: Interactive Selection Canvas -->
        <Canvas x:Name="SelectionCanvas" 
                Background="Transparent" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">

            <!-- Freehand Lasso Drawing Path (Glowing Neon Line) -->
            <Path x:Name="LassoDrawingPath" 
                  Stroke="#60A5FA" 
                  StrokeThickness="3" 
                  StrokeLineJoin="Round" 
                  StrokeStartLineCap="Round" 
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed">
                <Path.Effect>
                    <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                </Path.Effect>
            </Path>

            <!-- Selection Box Border -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="#3B82F6"
                    BorderThickness="2"
                    Background="Transparent"
                    CornerRadius="2"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#1D4ED8" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
            </Border>

            <!-- Corner Resize Handles -->
            <!-- Top-Left -->
            <Border x:Name="HandleTopLeft" Width="10" Height="10" Background="White" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" Cursor="SizeNWSE"/>
            <!-- Top-Right -->
            <Border x:Name="HandleTopRight" Width="10" Height="10" Background="White" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" Cursor="SizeNESW"/>
            <!-- Bottom-Left -->
            <Border x:Name="HandleBottomLeft" Width="10" Height="10" Background="White" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" Cursor="SizeNESW"/>
            <!-- Bottom-Right -->
            <Border x:Name="HandleBottomRight" Width="10" Height="10" Background="White" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" Cursor="SizeNWSE"/>

            <!-- Selection Dimensions Badge -->
            <Border x:Name="DimensionsBadge"
                    Background="#CC111827"
                    BorderBrush="#374151"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,2"
                    Visibility="Collapsed">
                <TextBlock x:Name="DimensionsText"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#93C5FD"
                           Text="0 × 0"/>
            </Border>

            <!-- Floating Action Menu -->
            <ui:ActionMenu x:Name="FloatingActionMenu" Visibility="Collapsed"/>
        </Canvas>

        <!-- Top Mode Selector & Help Pill -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,20,0,0"
                Background="#DD111827"
                BorderBrush="#374151"
                BorderThickness="1"
                CornerRadius="20"
                Padding="12,6">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Mode: Rectangle -->
                <RadioButton x:Name="RadioRect" 
                             Content="⬛  Rectangle (R)" 
                             GroupName="SnipMode" 
                             Foreground="#E5E7EB" 
                             FontSize="12" 
                             FontWeight="SemiBold" 
                             IsChecked="True" 
                             Cursor="Hand"
                             Margin="0,0,12,0" 
                             VerticalAlignment="Center"/>

                <!-- Mode: Circle / Lasso -->
                <RadioButton x:Name="RadioLasso" 
                             Content="⭕  Circle / Lasso (C)" 
                             GroupName="SnipMode" 
                             Foreground="#E5E7EB" 
                             FontSize="12" 
                             FontWeight="SemiBold" 
                             Cursor="Hand"
                             Margin="0,0,14,0" 
                             VerticalAlignment="Center"/>

                <Rectangle Width="1" Height="14" Fill="#4B5563" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <!-- Shortcut Hint -->
                <TextBlock Text="Drag to select • Esc to cancel" 
                           Foreground="#9CA3AF" 
                           FontSize="11" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
