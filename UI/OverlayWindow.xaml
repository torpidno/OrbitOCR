<Window x:Class="OrbitOCR.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:OrbitOCR.UI"
        mc:Ignorable="d"
        Title="OrbitOCR"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        Cursor="Cross">

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Layer 1: Frozen desktop screenshot -->
        <Image x:Name="FrozenScreenImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Layer 2: Dimmed overlay with cutout mask -->
        <Path x:Name="DimmedMaskPath" Fill="#66000000"/>

        <!-- Layer 3: Interactive selection canvas -->
        <Canvas x:Name="SelectionCanvas"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <!-- Subtle underlines marking detected words (Android Lens style) -->
            <Canvas x:Name="WordChipsCanvas" IsHitTestVisible="False" Opacity="0.85"/>

            <!-- Hover word highlight -->
            <Border x:Name="HoverWordBorder"
                    Background="#3360CDFF"
                    BorderBrush="#AA60CDFF"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>

            <!-- Active selected words -->
            <Canvas x:Name="SelectedWordsCanvas" IsHitTestVisible="False"/>

            <!-- Freehand lasso trail -->
            <Path x:Name="LassoDrawingPath"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="2.5"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Path.Effect>
                    <DropShadowEffect Color="#60CDFF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                </Path.Effect>
            </Path>

            <!-- Dashed rectangle drag marquee -->
            <Rectangle x:Name="DragRectangle"
                       Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="1.2"
                       StrokeDashArray="4 3"
                       Fill="#1460CDFF"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>

            <!-- Image selection box -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5"
                    Background="Transparent"
                    CornerRadius="3"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>

            <!-- Corner resize handles: 24px hit target, 12px visual dot -->
            <Border x:Name="HandleTopLeft" Width="24" Height="24" Background="Transparent" Cursor="SizeNWSE" Visibility="Collapsed">
                <Border Width="12" Height="12" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6"/>
            </Border>
            <Border x:Name="HandleTopRight" Width="24" Height="24" Background="Transparent" Cursor="SizeNESW" Visibility="Collapsed">
                <Border Width="12" Height="12" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6"/>
            </Border>
            <Border x:Name="HandleBottomLeft" Width="24" Height="24" Background="Transparent" Cursor="SizeNESW" Visibility="Collapsed">
                <Border Width="12" Height="12" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6"/>
            </Border>
            <Border x:Name="HandleBottomRight" Width="24" Height="24" Background="Transparent" Cursor="SizeNWSE" Visibility="Collapsed">
                <Border Width="12" Height="12" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6"/>
            </Border>

            <!-- Image dimensions badge -->
            <Border x:Name="DimensionsBadge"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="7,2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="DimensionsText"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           Text="0 × 0 px"/>
            </Border>

            <!-- Floating action menu -->
            <ui:ActionMenu x:Name="FloatingActionMenu" Visibility="Collapsed"/>
        </Canvas>

        <!-- Top status & guide pill -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15,8">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.55"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusMessage"
                           Text="Scanning screen for text…"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>

                <Rectangle Width="1" Height="13" Fill="{StaticResource BorderBrush}" Margin="13,0" VerticalAlignment="Center"/>

                <TextBlock Text="Drag to select • Hold Alt to circle • Esc to exit"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
