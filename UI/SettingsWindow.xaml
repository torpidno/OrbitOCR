<Window x:Class="OrbitOCR.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OrbitOCR Settings"
        Width="660"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="{StaticResource PagePadding}">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="Global shortcut, behavior and text recognition"
                       Style="{StaticResource SettingDescription}"/>
        </StackPanel>

        <!-- ===== Body ===== -->
        <StackPanel Grid.Row="1" Margin="24,4,24,8">

            <!-- Shortcut -->
            <TextBlock Text="Shortcut" Style="{StaticResource SectionHeader}"
                       AutomationProperties.HeadingLevel="Level2"/>
            <Border Style="{StaticResource Card}">
                <Grid Margin="{StaticResource CardPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="{StaticResource RowPadding}" VerticalAlignment="Center">
                        <TextBlock Text="Global shortcut" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Press this anywhere in Windows to capture and search your screen"
                                   Style="{StaticResource SettingDescription}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <WrapPanel x:Name="KeycapsContainer" Orientation="Horizontal"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button x:Name="BtnRecordShortcut" Style="{StaticResource GhostButton}"
                                Padding="12,0" MinWidth="0"
                                AutomationProperties.Name="Record a new shortcut">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RecordDot" Width="8" Height="8"
                                         Fill="{StaticResource TextTertiaryBrush}"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtRecordButton" Text="Record" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnTestSnip" Style="{StaticResource SubtleButton}"
                                Padding="10,0" Margin="4,0,0,0"
                                AutomationProperties.Name="Test shortcut now">
                            <TextBlock Text="Test"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Behavior -->
            <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}" Margin="0,20,0,8"
                       AutomationProperties.HeadingLevel="Level2"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="{StaticResource CardPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="{StaticResource RowPadding}">
                            <TextBlock Text="Auto-copy recognized text" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Copy to the clipboard as soon as a selection is made"
                                       Style="{StaticResource SettingDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkAutoCopy" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  AutomationProperties.Name="Auto-copy recognized text"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="16,0"/>

                    <Grid Margin="{StaticResource CardPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="{StaticResource RowPadding}">
                            <TextBlock Text="Sound feedback" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Play a soft chime when text or an image is copied"
                                       Style="{StaticResource SettingDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkPlaySounds" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  AutomationProperties.Name="Sound feedback"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="16,0"/>

                    <Grid Margin="{StaticResource CardPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="{StaticResource RowPadding}">
                            <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Launch quietly into the system tray at sign-in"
                                       Style="{StaticResource SettingDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkStartWithWindows" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  AutomationProperties.Name="Start with Windows"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recognition -->
            <TextBlock Text="Recognition" Style="{StaticResource SectionHeader}" Margin="0,20,0,8"
                       AutomationProperties.HeadingLevel="Level2"/>
            <Border Style="{StaticResource Card}">
                <Grid Margin="{StaticResource CardPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="{StaticResource RowPadding}" VerticalAlignment="Center">
                        <TextBlock Text="OCR language" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Text is recognized on this device by the built-in Windows engine"
                                   Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" x:Name="CmbOcrLanguage" Style="{StaticResource FieldComboBox}"
                              Width="260" VerticalAlignment="Center" Margin="16,0,0,0"
                              AutomationProperties.Name="OCR language"/>
                </Grid>
            </Border>

            <!-- Save / hotkey-registration status -->
            <TextBlock x:Name="TxtStatus" Visibility="Collapsed"
                       Margin="0,16,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}"
                       AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" Padding="{StaticResource FooterPadding}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnExitApp" Content="Exit app"
                        Style="{StaticResource SubtleButton}" Padding="0,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="2" x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="3" x:Name="BtnSave" Content="Save"
                        Style="{StaticResource AccentButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
